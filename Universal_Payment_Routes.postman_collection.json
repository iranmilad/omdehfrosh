									"        pm.environment.set(\"cod_message\", response.message);",
									"        console.log(\"✅ COD Payment Response:\", response);",
									"    }",
									"} else if (pm.response.code === 200 && response.body) {",
									"    // If it returns { link, body } instead (shouldn't happen but handle it)",
