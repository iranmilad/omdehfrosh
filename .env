REACT_APP_CACHE_ENCRYPTION_KEY=your-super-secret-encryption-key-change-this-in-production
REACT_APP_ENABLE_CACHING=true


JWT_SECRET=yourSecretKey

# REACT_APP_SECRET_KEY="@#$@#$@$@@@@@@@@@@@242344444444444234ssfsfSSSSSSSSFSDFSF@#$24"


# .env.development (for development with mock)
REACT_APP_USE_MOCK=true
REACT_APP_API_BASE_URL=http://localhost:5000/api

# .env.development.local (for development with real API)
REACT_APP_USE_MOCK=false
REACT_APP_API_BASE_URL=http://localhost:5000/api

# .env.production
REACT_APP_USE_MOCK=false
REACT_APP_API_BASE_URL=http://localhost:5000/api

# .env.local (override for local testing)
# REACT_APP_USE_MOCK=false
# REACT_APP_API_BASE_URL=https://panel.j2b.market

# ============================================================================
# REACT QUERY CACHE CONFIGURATION
# ============================================================================

# Enable/Disable caching globally
REACT_APP_CACHE_ENABLED=true

# Debug mode (logs cache operations in console)
REACT_APP_CACHE_DEBUG=true

# Show error notifications globally
REACT_APP_CACHE_SHOW_ERROR_NOTIFICATIONS=true

# ============================================================================
# STALE TIME SETTINGS (in milliseconds)
# How long data is considered "fresh" before background refetch triggers
# ============================================================================
REACT_APP_CACHE_STALE_INSTANT=10000
REACT_APP_CACHE_STALE_SHORT=30000
REACT_APP_CACHE_STALE_MEDIUM=120000
REACT_APP_CACHE_STALE_LONG=300000
REACT_APP_CACHE_STALE_EXTENDED=900000
REACT_APP_CACHE_STALE_SESSION=1800000
REACT_APP_CACHE_STALE_STATIC=3600000

# ============================================================================
# GARBAGE COLLECTION TIME SETTINGS (in milliseconds)
# How long inactive/unused data stays in memory before being removed
# ============================================================================
REACT_APP_CACHE_GC_SHORT=60000
REACT_APP_CACHE_GC_MEDIUM=300000
REACT_APP_CACHE_GC_LONG=900000
REACT_APP_CACHE_GC_SESSION=1800000
REACT_APP_CACHE_GC_EXTENDED=3600000
REACT_APP_CACHE_GC_PERSISTENT=86400000

# ============================================================================
# RETRY SETTINGS
# Number of retry attempts for failed requests
# ============================================================================
REACT_APP_CACHE_RETRY_MINIMAL=1
REACT_APP_CACHE_RETRY_STANDARD=2
REACT_APP_CACHE_RETRY_EXTENDED=3

# ============================================================================
# NETWORK SETTINGS
# ============================================================================
REACT_APP_CACHE_REFETCH_ON_FOCUS=false
REACT_APP_CACHE_REFETCH_ON_RECONNECT=true
REACT_APP_CACHE_REFETCH_INTERVAL=0